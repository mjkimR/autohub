# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Hidden files
.*
!/modules/hub-ui/.prettierignore
!.gitignore
!.env.example
!.nvmrc
!.python-version
!.vscode
!.github
# devkit keeps its own .devkit/.gitignore for the generated parts.
!.devkit

# Generated agent assets are installed by devkit.
.agents/
.claude/
.codex/
apm_modules/

# Credentials. Keep keys outside the repo (e.g. ~/.config/scheduler-mgr/sa-key.json).
# Google's SA key download lands in the repo root as <project>-<keyid>.json, so the
# root is denied wholesale rather than pattern-matched.
secrets/
*sa-key.json
*service-account*.json
*credentials*.json
/*.json
!/package-lock.json

# Virtual environments
.venv

# Docker
!.dockerignore
!.gcloudignore

# Others
**/logs
