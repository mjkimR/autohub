# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Hidden files
.*
!.gitignore
!.env.example
!.nvmrc
!.python-version
!.vscode
!.github

# Common agent tools for development
!.agents
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/app-common/
!.claude/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/app-common/
apm_modules/

# Credentials. Keep keys outside the repo (e.g. ~/.config/scheduler-mgr/sa-key.json).
# Google's SA key download lands in the repo root as <project>-<keyid>.json, so the
# root is denied wholesale rather than pattern-matched.
secrets/
*sa-key.json
*service-account*.json
*credentials*.json
/*.json
!/package-lock.json

# Virtual environments
.venv

# Docker
!.dockerignore

# Others
**/logs
